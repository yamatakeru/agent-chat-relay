{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/vendor/pi/adapter.js"],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "typescript/await-thenable": "off"
      }
    },
    {
      "files": ["test/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "regex": "^(node:)?fs(/promises)?$",
            "importNames": ["mkdtemp", "mkdtempSync", "mkdtempDisposable", "mkdtempDisposableSync"],
            "message": "test/tmp.ts の tempDir() を使う。ミューテーションでテストが途中で止まっても一時ディレクトリを片付けるため。"
          }]
        }]
      }
    }
  ]
}
