@@ -0,0 +1,65 @@
+import { lstatSync, realpathSync, statSync } from 'node:fs'
+import { isAbsolute, join, relative, sep } from 'node:path'
+import { RequestError, type McpServer } from '@agentclientprotocol/sdk'
+
+function inside(parent: string, child: string): boolean {
+  const rel = relative(parent, child)
+  return !!rel && rel !== '..' && !rel.startsWith(`..${sep}`) && !isAbsolute(rel)
+}
+
+function directory(path: string | undefined): string {
+  if (!path || !isAbsolute(path)) throw new Error()
+  const real = realpathSync(path)
+  if (!statSync(real).isDirectory()) throw new Error()
+  return real
+}
+
+export function managedPiPaths() {
+  if (process.env.PI_ACP_MANAGED_CHAT_WORKSPACE === undefined) return
+  try {
+    const workspace = directory(process.env.PI_ACP_MANAGED_CHAT_WORKSPACE)
+    const agentDir = directory(process.env.PI_CODING_AGENT_DIR)
+    const sessions = directory(join(agentDir, 'sessions'))
+    const map = join(agentDir, 'pi-acp-session-map.json')
+    if (workspace === agentDir || inside(workspace, agentDir) || inside(agentDir, workspace) || !inside(agentDir, sessions)) {
+      throw new Error()
+    }
+    const entry = lstatSync(map, { throwIfNoEntry: false })
+    if (entry && !entry.isFile()) throw new Error()
+    return { workspace, sessions, map }
+  } catch {
+    throw RequestError.internalError(undefined, 'Managed Pi state is not configured')
+  }
+}
+
+export function managedSessionFile(sessions: string, file: string): string | undefined {
+  try {
+    if (!isAbsolute(file)) return
+    const real = realpathSync(file)
+    if (inside(sessions, real) && statSync(real).isFile()) return real
+  } catch {
+    // 記録があっても、専用領域の実ファイルを確認できなければ再開しない。
+  }
+}
+
+export function managedCwdMatches(cwd: string, workspace: string): boolean {
+  try {
+    return directory(cwd) === workspace
+  } catch {
+    return false
+  }
+}
+
+export function managedChatInput(cwd: string, servers?: McpServer[]) {
+  const managed = managedPiPaths()
+  if (!managed) return
+  const server = servers?.[0]
+  if (!managedCwdMatches(cwd, managed.workspace) || servers?.length !== 1 || !server ||
+      !('type' in server) || server.type !== 'http' || server.name !== 'chat' ||
+      !/^http:\/\/127\.0\.0\.1:[0-9]+\/mcp$/.test(server.url) || server.headers.length !== 1 ||
+      server.headers[0]?.name.toLowerCase() !== 'authorization' ||
+      !/^Bearer [A-Za-z0-9_-]{43}$/.test(server.headers[0].value)) {
+    throw RequestError.invalidParams('Managed chat requires relay loopback HTTP MCP on session/new or session/load')
+  }
+  return { url: server.url, authorization: server.headers[0].value }
+}
