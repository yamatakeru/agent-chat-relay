+  private async prepareManagedChat(pipe: Duplex, input: NonNullable<SpawnParams['managedChat']>): Promise<void> {
+    // 認証ヘッダーは子専用のパイプで一度だけ渡す。RPC 行や起動引数に混ぜない。
+    let finished!: (ready: boolean) => void
+    const result = new Promise<boolean>(resolve => { finished = resolve })
+    const onExit = () => finished(false)
+    const timeout = setTimeout(onExit, 10_000)
+    const unsubscribe = this.onEvent(ev => {
+      if (ev.type !== 'extension_ui_request' || ev.method !== 'notify') return
+      if (ev.message === 'managed-chat:ready') finished(true)
+      if (ev.message === 'managed-chat:failed') finished(false)
+    })
+    this.child.once('exit', onExit)
+    if (this.child.exitCode !== null || this.child.signalCode !== null) onExit()
+    pipe.on('error', onExit)
+    try {
+      pipe.end(JSON.stringify(input))
+      if (!(await result)) throw new Error('Managed chat MCP initialization failed')
+    } finally {
+      clearTimeout(timeout)
+      unsubscribe()
+      this.child.off('exit', onExit)
+      pipe.destroy()
+    }
+  }
