{
  "name": "agent-chat-relay",
  "version": "0.1.1",
  "description": "LINE・Chatwork・Discord のルームから、Claude Code などのコーディングエージェントに作業を依頼するための中継サーバー（ACP・MCP）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamatakeru/agent-chat-relay.git"
  },
  "homepage": "https://github.com/yamatakeru/agent-chat-relay#readme",
  "bugs": "https://github.com/yamatakeru/agent-chat-relay/issues",
  "keywords": [
    "acp",
    "mcp",
    "claude-code",
    "line",
    "chatwork",
    "discord",
    "agent"
  ],
  "type": "module",
  "bin": {
    "agent-chat-relay": "bin/agent-chat-relay",
    "ac-relay": "bin/agent-chat-relay"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "relay": "bin/agent-chat-relay",
    "test": "bun test",
    "check": "tsc --noEmit && oxlint && bun --no-env-file --config=/dev/null scripts/check.ts",
    "docs:adr": "bun --no-env-file --config=/dev/null scripts/adr-index.ts",
    "mutation": "scripts/mutation.sh"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@agentclientprotocol/sdk": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "discord.js": "14.28.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "fallow": "3.44.0",
    "fast-check": "4.10.3",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  }
}
